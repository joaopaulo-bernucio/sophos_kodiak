# ===============================
# SOPHOS KODIAK - BACKEND ENVIRONMENT VARIABLES
# ===============================
#
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no repositório!
#
# ===============================

# ===============================
# DATABASE CONFIGURATION (SUPABASE)
# ===============================
# Dados de conexão com o banco de dados Supabase
DB_HOST=your_supabase_host_here
DB_PORT=6543
DB_NAME=postgres
DB_USER=your_supabase_user_here
DB_PASSWORD=your_supabase_password_here

# ===============================
# AI/ML SERVICES
# ===============================
# Chave da API do Google Gemini para processamento de linguagem natural
GEMINI_API_KEY=your_gemini_api_key_here

# ===============================
# APPLICATION SETTINGS
# ===============================
# Ambiente da aplicação (development, testing, production)
FLASK_ENV=development

# ===============================
# NOTES FOR CI/CD
# ===============================
# Para GitHub Actions, configure os seguintes secrets:
# - DB_HOST (para testes locais, use 'localhost')
# - DB_PORT (para testes locais, use '5432')
# - DB_NAME (para testes locais, use 'test_db')
# - DB_USER (para testes locais, use 'postgres')
# - DB_PASSWORD (para testes locais, use 'postgres')
# - GEMINI_API_KEY (sua chave real ou uma de teste)
