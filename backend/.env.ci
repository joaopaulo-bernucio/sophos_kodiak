# Configurações específicas para CI/CD
# Este arquivo é carregado automaticamente quando CI=true ou GITHUB_ACTIONS está definido

# ==========================================
# API GEMINI - USAR REAL COM CHAVE DE TESTE
# ==========================================
# Usar API real do Gemini com chave específica para CI
# Apenas em casos extremos usar mock (GEMINI_API_ENDPOINT=mock)
GEMINI_API_KEY=test_gemini_api_key_for_github_actions_testing_only
# GEMINI_API_ENDPOINT=mock  # Desabilitado para permitir testes reais

# ==========================================
# BANCO DE DADOS - CONFIGURAÇÕES PARA TESTES
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# ==========================================
# FLASK - CONFIGURAÇÕES DE TESTE
# ==========================================
FLASK_ENV=testing
FLASK_DEBUG=false

# ==========================================
# CACHE E REDIS - CONFIGURAÇÕES REAIS
# ==========================================
CACHE_DURATION=300
# REDIS_URL=mock://localhost:6379  # Removido mock
REDIS_URL=redis://localhost:6379

# ==========================================
# RATE LIMITING - VALORES REAIS PARA CI
# ==========================================
MAX_REQUESTS_PER_MINUTE=10
RATE_LIMIT_ENABLED=true

# ==========================================
# TIMEOUTS PARA CI - VALORES APROPRIADOS
# ==========================================
REQUEST_TIMEOUT=15
CONNECT_TIMEOUT=8

# ==========================================
# LOGGING PARA CI - EQUILIBRADO
# ==========================================
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# ==========================================
# PERFORMANCE - RECURSOS APROPRIADOS
# ==========================================
MAX_WORKERS=4
MAX_CONNECTIONS=20

# ==========================================
# SEGURANÇA - CHAVES DE TESTE APENAS
# ==========================================
SECRET_KEY=test_secret_key_for_ci_only_not_for_production
JWT_SECRET_KEY=test_jwt_secret_for_ci_only

# ==========================================
# FEATURES PARA TESTE - CONFIGURAÇÃO REAL
# ==========================================
# Removidos os mocks para permitir testes reais
# ENABLE_MOCK_RESPONSES=true  # Desabilitado
# SKIP_EXTERNAL_APIS=true     # Desabilitado
# USE_MEMORY_CACHE=true       # Desabilitado

# Configurações para testes reais
ENABLE_REAL_API_TESTS=true
ENABLE_DATABASE_TESTS=true
ENABLE_EXTERNAL_DEPENDENCIES=true

# ==========================================
# PYTEST E CI ESPECÍFICO
# ==========================================
PYTEST_CURRENT_TEST=true
CI=true

# ==========================================
# CONFIGURAÇÕES PARA ANÁLISE REAL DO CÓDIGO
# ==========================================
# Permite que os testes analisem o comportamento real da aplicação
ANALYZE_REAL_CODE=true
VALIDATE_ACTUAL_LOGIC=true
TEST_REAL_SCENARIOS=true

# ==========================================
# INFORMAÇÕES ADICIONAIS PARA DEBUG
# ==========================================
# Este arquivo configura testes que analisam o código REAL da aplicação
# - A API Gemini usará resposta real (ou fallback inteligente)
# - O banco de dados será testado com operações reais
# - As funcionalidades serão validadas conforme implementadas
#
# Para forçar uso local: export CI=true && ./run_tests.sh
# Para uso normal local: apenas execute ./run_tests.sh
#
# Os testes vão analisar:
# - Lógica real de processamento NLP
# - Queries SQL reais no banco
# - Integração real com APIs externas (quando disponível)
# - Comportamento real dos endpoints
# ==========================================
