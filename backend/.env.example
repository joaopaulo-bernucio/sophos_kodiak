# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no repositório!

# DATABASE CONFIGURATION (SUPABASE)
DB_HOST=your_supabase_host_here
DB_PORT=6543  # Porta padrão do Supabase
DB_NAME=postgres
DB_USER=your_supabase_user_here
DB_PASSWORD=your_supabase_password_here

# AI/ML SERVICES
GEMINI_API_KEY=your_gemini_api_key_here

# APPLICATION SETTINGS
FLASK_ENV=development

# NOTES FOR CI/CD
# Para GitHub Actions, configure os seguintes secrets:
# - DB_HOST (ex: 'localhost' para testes locais ou seu host Supabase)
# - DB_PORT (ex: '6543' para Supabase, '5432' para PostgreSQL local)
# - DB_NAME
# - DB_USER
# - DB_PASSWORD
# - GEMINI_API_KEY
