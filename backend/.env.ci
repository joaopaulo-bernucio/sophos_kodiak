# FLASK - CONFIGURAÇÕES DE TESTE
FLASK_ENV=testing
FLASK_DEBUG=false

# BANCO DE DADOS PARA CI - Usar variáveis do GitHub Actions
# Estas variáveis serão sobrescritas pelas secrets do GitHub Actions
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db

# GEMINI API - Para testes
GEMINI_API_KEY=test_key_for_ci
USE_MOCK_GEMINI=true

# CACHE (se necessário)
CACHE_DURATION=300

# RATE LIMITING (se usado)
MAX_REQUESTS_PER_MINUTE=10
RATE_LIMIT_ENABLED=true

# TIMEOUTS PARA CI
REQUEST_TIMEOUT=15
CONNECT_TIMEOUT=8

# LOGGING PARA CI
LOG_LEVEL=INFO
LOG_FORMAT=detailed

# PERFORMANCE
MAX_WORKERS=4
MAX_CONNECTIONS=20

# FEATURES PARA TESTE
ENABLE_REAL_API_TESTS=true
ENABLE_DATABASE_TESTS=true
ENABLE_EXTERNAL_DEPENDENCIES=true

# PYTEST E CI ESPECÍFICO
PYTEST_CURRENT_TEST=true
CI=true

# CONFIGURAÇÕES PARA ANÁLISE REAL DO CÓDIGO
ANALYZE_REAL_CODE=true
VALIDATE_ACTUAL_LOGIC=true
TEST_REAL_SCENARIOS=true
