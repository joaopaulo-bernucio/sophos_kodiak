{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Executar Testes Backend",
			"type": "shell",
			"command": "./run_tests.sh",
			"args": [
				"--quick"
			],
			"options": {
				"cwd": "${workspaceFolder}/backend"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": [
				"$python"
			],
			"isBackground": false
		}
	]
}
